# ─────────────────────────────────────────────────────────────
# Inkwell — environment variables
# Copy this file to `.env.local` and replace the placeholders.
# NEVER commit real values. Variables without NEXT_PUBLIC_ are
# server-only and are never sent to the browser.
# ─────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────
# Canonical public URL, no trailing slash. Used for sitemap, RSS, canonical tags, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Inkwell
NEXT_PUBLIC_SITE_TAGLINE=Essays on writing, craft and curiosity
# Shown on the Contact / Privacy / Terms pages. Optional.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# ── Supabase (Auth + PostgreSQL + Storage) ───────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# SERVER ONLY. Bypasses Row Level Security. Used for contact form, comments,
# newsletter, view counting, rate limiting and AI usage logging. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Public Storage bucket for cover and inline images (created by the migration).
SUPABASE_STORAGE_BUCKET=covers
# Set to "true" only if you run Supabase locally over http://127.0.0.1 (disables next/image optimisation).
NEXT_IMAGE_UNOPTIMIZED=false

# ── Privacy / abuse protection ───────────────────────────────
# Random secret used to hash IP addresses before they are used for rate limiting
# and stored with comments/messages. Generate with: openssl rand -hex 32
IP_HASH_SALT=REPLACE_WITH_A_LONG_RANDOM_STRING

# ── Reader features ──────────────────────────────────────────
# Comments are held for moderation before they appear. Set to "false" to disable entirely.
COMMENTS_ENABLED=true
# Newsletter sign-up form (stores consented addresses; sending requires an external provider).
NEWSLETTER_ENABLED=true

# ── AI writing assistant (server-side only) ──────────────────
# Leave AI_API_KEY empty to disable AI tools; the dashboard will say so honestly.
# AI_PROVIDER: anthropic | openai | openai-compatible
AI_PROVIDER=anthropic
AI_API_KEY=YOUR_AI_PROVIDER_API_KEY
# Model identifier for the chosen provider. Defaults: anthropic → claude-sonnet-5-5, openai → gpt-4o-mini
AI_MODEL=claude-sonnet-5-5
# Only for openai-compatible providers (OpenRouter, Together, Ollama, vLLM, Azure…) or API proxies.
# Example: https://openrouter.ai/api/v1
AI_BASE_URL=
# Usage limits
AI_DAILY_LIMIT_PER_USER=40
AI_REQUESTS_PER_MINUTE=6
AI_MAX_OUTPUT_TOKENS=4096
